# Copy to backend/.env and fill in. Never commit the real .env.

# Claude fact extraction ("Extract with Claude", and the paid evals in eval/).
ANTHROPIC_API_KEY=

# Live microphone transcription. Not needed for the scripted calls.
DEEPGRAM_API_KEY=

# Optional: which Claude model extracts the facts. The default is set in
# app/services/extractor.py. If you change it, re-run the evals before quoting
# their numbers: every results file records the model that produced it.
# CIVOPS_EXTRACTION_MODEL=claude-haiku-4-5

# Optional, standalone microphone script only (python -m scripts.live_microphone).
# POST /transcript/event is disabled unless this is set, and the script must
# send the same value. The console's own Start Call never needs it.
# CIVOPS_EVENT_TOKEN=
# CIVOPS_API_URL=http://127.0.0.1:8000

# Optional: where the SQLite call log lives (default backend/data/civops.db, gitignored).
# CIVOPS_DB_PATH=
# Optional: also store live-microphone transcript text and evidence quotes in the
# call log. Off by default: only scripted (fictional) calls keep their words.
# CIVOPS_STORE_LIVE_TRANSCRIPTS=1
