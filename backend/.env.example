# Copy to backend/.env and fill in. Never commit the real .env.

# Claude fact extraction ("Extract with Claude", and the paid evals in eval/).
ANTHROPIC_API_KEY=

# Live microphone transcription. Not needed for the scripted calls.
DEEPGRAM_API_KEY=

# Optional: which Claude model extracts the facts. The default is set in
# app/services/extractor.py. If you change it, re-run the evals before quoting
# their numbers: every results file records the model that produced it.
# CIVOPS_EXTRACTION_MODEL=claude-haiku-4-5
